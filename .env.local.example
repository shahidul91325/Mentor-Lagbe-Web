# ============================================================
# MentorLagbe Web — Environment Variables (example)
# Copy this file to .env.local and fill in real values.
# Only NEXT_PUBLIC_* values are exposed to the browser,
# so never put secrets here.
# ============================================================

# Backend API base URL (no trailing slash)
# Local dev: http://localhost:5000  |  Production: https://mentor-lagbe-web-server.vercel.app
NEXT_PUBLIC_API_URL=http://localhost:5000
